<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Off by default: switch on once the store configuration and the
             product mappings have been validated on a manual run. -->
        <record id="ir_cron_shopify_import_orders" model="ir.cron">
            <field name="name">Shopify: Import Orders</field>
            <field name="model_id" ref="model_shopify_store"/>
            <field name="state">code</field>
            <field name="code">model._cron_import_orders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="False"/>
            <field name="priority">5</field>
        </record>

        <!-- Picks up jobs whose earlier attempt failed and is due for a retry. -->
        <record id="ir_cron_shopify_process_queue" model="ir.cron">
            <field name="name">Shopify: Process Sync Queue</field>
            <field name="model_id" ref="model_shopify_sync_queue"/>
            <field name="state">code</field>
            <field name="code">model._cron_process_queue()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="False"/>
            <field name="priority">6</field>
        </record>

        <record id="ir_cron_shopify_gc" model="ir.cron">
            <field name="name">Shopify: Clean Sync History</field>
            <field name="model_id" ref="model_shopify_sync_log"/>
            <field name="state">code</field>
            <field name="code">model._gc_logs()
env['shopify.sync.queue']._gc_queue()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="active" eval="True"/>
            <field name="priority">10</field>
        </record>

    </data>
</odoo>
