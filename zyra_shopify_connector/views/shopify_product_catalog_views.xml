<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="shopify_product_catalog_view_list" model="ir.ui.view">
        <field name="name">shopify.product.catalog.list</field>
        <field name="model">shopify.product.catalog</field>
        <field name="arch" type="xml">
            <list string="Link Variants" editable="bottom" create="false" delete="false"
                  decoration-muted="state == 'mapped'"
                  decoration-warning="state == 'unmapped'">
                <header>
                    <button name="action_open_fetch_wizard" type="object"
                            string="Fetch from Shopify" class="btn-primary" icon="fa-download"/>
                    <button name="action_use_suggestion" type="object"
                            string="Use Suggestions" class="btn-secondary" icon="fa-magic"
                            confirm="Apply the suggested Odoo product on every unmapped row that has a suggestion?"/>
                </header>
                <field name="shopify_product_title" string="Product" readonly="1" optional="hide"/>
                <field name="shopify_model_code" string="Model" readonly="1" optional="show"/>
                <field name="shopify_color" string="Color" readonly="1"/>
                <field name="shopify_size" string="Size" readonly="1"/>
                <field name="sku" string="SKU" readonly="1"/>
                <field name="suggested_product_id" string="Suggested Odoo Variant" readonly="1" optional="hide"/>
                <field name="product_id" string="Odoo Variant"
                       options="{'no_create': True}"/>
                <field name="state" string="Status" widget="badge"
                       decoration-success="state == 'mapped'"
                       decoration-warning="state == 'unmapped'"/>
                <field name="shopify_variant_title" string="Shopify Label" readonly="1" optional="hide"/>
                <field name="barcode" string="Barcode" readonly="1" optional="hide"/>
                <field name="shopify_variant_id" string="Variant ID" readonly="1" optional="hide"/>
                <field name="store_id" optional="hide"/>
                <field name="mapping_id" column_invisible="True"/>
                <field name="company_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="shopify_product_catalog_view_search" model="ir.ui.view">
        <field name="name">shopify.product.catalog.search</field>
        <field name="model">shopify.product.catalog</field>
        <field name="arch" type="xml">
            <search string="Link Variants">
                <field name="shopify_product_title"/>
                <field name="shopify_model_code"/>
                <field name="shopify_color"/>
                <field name="shopify_size"/>
                <field name="sku"/>
                <field name="barcode"/>
                <field name="shopify_variant_id"/>
                <field name="product_id"/>
                <field name="suggested_product_id"/>
                <field name="store_id"/>
                <filter name="unmapped" string="Not Linked"
                        domain="[('state', '=', 'unmapped')]"/>
                <filter name="mapped" string="Linked"
                        domain="[('state', '=', 'mapped')]"/>
                <filter name="has_suggestion" string="Has Suggestion"
                        domain="[('suggested_product_id', '!=', False), ('state', '=', 'unmapped')]"/>
                <group>
                    <filter name="group_product" string="Product"
                            context="{'group_by': 'shopify_product_title'}"/>
                    <filter name="group_model" string="Model Code"
                            context="{'group_by': 'shopify_model_code'}"/>
                    <filter name="group_color" string="Color"
                            context="{'group_by': 'shopify_color'}"/>
                    <filter name="group_store" string="Store"
                            context="{'group_by': 'store_id'}"/>
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_shopify_product_catalog" model="ir.actions.act_window">
        <field name="name">Link Variants</field>
        <field name="res_model">shopify.product.catalog</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="shopify_product_catalog_view_search"/>
        <field name="context">{'search_default_unmapped': 1, 'search_default_group_product': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No Shopify variants loaded yet</p>
            <p>
                <strong>Step 1:</strong>
                <a type="action" name="%(zyra_shopify_connector.action_shopify_fetch_catalog_wizard)d"
                   class="btn btn-primary">Fetch from Shopify</a>
            </p>
            <p class="mt-2">
                Each row is one <strong>size + color combination</strong> from Shopify.
                <em>Beige / 10</em> means <strong>Color = Beige</strong> and <strong>Size = 10</strong>.
            </p>
            <p>
                Pick the matching <strong>Odoo variant</strong> in the last column.
                Rows are grouped by product so you can link all sizes for one shoe at a time.
            </p>
        </field>
    </record>

</odoo>
