<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_shopify" model="ir.module.category">
        <field name="name">Shopify</field>
        <field name="description">Shopify connector access levels.</field>
        <field name="sequence">90</field>
    </record>

    <record id="group_shopify_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_shopify"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="comment">Run order imports, fix product and customer mappings, read sync logs.</field>
    </record>

    <record id="group_shopify_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_shopify"/>
        <field name="implied_ids" eval="[(4, ref('group_shopify_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Configure stores and credentials, in addition to everything a Shopify User can do.</field>
    </record>

    <!-- Multi-company isolation. Every connector model carries a stored
         company_id, either its own or related from the store. -->

    <record id="shopify_store_company_rule" model="ir.rule">
        <field name="name">Shopify Store: multi-company</field>
        <field name="model_id" ref="model_shopify_store"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="shopify_order_company_rule" model="ir.rule">
        <field name="name">Shopify Order: multi-company</field>
        <field name="model_id" ref="model_shopify_order"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="shopify_order_line_company_rule" model="ir.rule">
        <field name="name">Shopify Order Line: multi-company</field>
        <field name="model_id" ref="model_shopify_order_line"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('store_id.company_id', '=', False), ('store_id.company_id', 'in', company_ids)]</field>
    </record>

    <record id="shopify_customer_mapping_company_rule" model="ir.rule">
        <field name="name">Shopify Customer Mapping: multi-company</field>
        <field name="model_id" ref="model_shopify_customer_mapping"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="shopify_product_mapping_company_rule" model="ir.rule">
        <field name="name">Shopify Product Mapping: multi-company</field>
        <field name="model_id" ref="model_shopify_product_mapping"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="shopify_product_catalog_company_rule" model="ir.rule">
        <field name="name">Shopify Product Catalog: multi-company</field>
        <field name="model_id" ref="model_shopify_product_catalog"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="shopify_variant_mapping_company_rule" model="ir.rule">
        <field name="name">Shopify Variant Mapping: multi-company</field>
        <field name="model_id" ref="model_shopify_variant_mapping"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="shopify_sync_queue_company_rule" model="ir.rule">
        <field name="name">Shopify Sync Queue: multi-company</field>
        <field name="model_id" ref="model_shopify_sync_queue"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="shopify_sync_log_company_rule" model="ir.rule">
        <field name="name">Shopify Sync Log: multi-company</field>
        <field name="model_id" ref="model_shopify_sync_log"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
